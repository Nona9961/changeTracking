target/
*.class
.idea/
*.iml

# 环境特定：代理 settings 引用（本机 /opt/code/.m2/settings.xml）
.mvn/maven.config


# Issues (local dev records, not tracked)
/issues/

# CodeGraph local index (build artifact, host watcher maintains)
.codegraph/

# Benchmark result archive: archived run outputs are evidence, not sources; the archives a
# maintainer picked by hand below committed/ are the exception and are tracked
change-tracking-benchmark/benchmark/results/*
!change-tracking-benchmark/benchmark/results/committed/
